{
  "manifest_version": 3,
  "name": "password generator",
  "version": "0.1",
  "description": "password generator",
  "icons": {
    "48": "letter.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "css":["main.css"]
    }
  ],
  "background": {
    "scripts": ["background.js", "eventPage.js"],
    "persistent": false
  },
  "permissions": ["contextMenus", "activeTab", "tabs","storage",
    "scripting"],
  "action":{
    "default_title":"Chrome Password Generator",
    "default_popup":"main.html"
  },
  
  "browser_action": {
    "default_icon": "letter.png",
    "default_popup": "main.html"
  }
} 
